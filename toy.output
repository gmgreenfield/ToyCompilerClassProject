Grammar

    0 $accept: program $end

    1 program: decls procs

    2 ifthenelse_stmt: IF LPAREN expr RPAREN LBRACE stmts RBRACE ELSE LBRACE stmts RBRACE

    3 while_stmt: WHILE LPAREN expr RPAREN LBRACE stmts RBRACE

    4 procs: procdecl procs
    5      | /* empty */

    6 decls: decl SEMICOLON decls
    7      | /* empty */

    8 procdecl: PROC var LPAREN vars RPAREN LBRACE decls stmts RBRACE

    9 vars: var vars_tail

   10 vars_tail: COMMA vars
   11          | /* empty */

   12 args: expr args_tail

   13 args_tail: COMMA args
   14          | /* empty */

   15 stmts: stmt SEMICOLON stmts
   16      | /* empty */

   17 stmt: ifthenelse_stmt
   18     | while_stmt
   19     | f_call
   20     | assign
   21     | read
   22     | write

   23 f_call: CALL var LPAREN args RPAREN

   24 decl: DECLARE NAME

   25 assign: var ASSIGN expr

   26 read: READ var

   27 write: WRITE expr

   28 expr: term
   29     | term PLUS term
   30     | term MINUS term

   31 term: NUMBER
   32     | var
   33     | LPAREN expr RPAREN

   34 var: NAME


Terminals, with rules where they appear

$end (0) 0
error (256)
NAME (258) 24 34
NUMBER (259) 31
LPAREN (260) 2 3 8 23 33
RPAREN (261) 2 3 8 23 33
LBRACE (262) 2 3 8
RBRACE (263) 2 3 8
ASSIGN (264) 25
SEMICOLON (265) 6 15
PLUS (266) 29
MINUS (267) 30
COMMA (268) 10 13
DECLARE (269) 24
WRITE (270) 27
READ (271) 26
CALL (272) 23
PROC (273) 8
ELSE (274) 2
IF (275) 2
WHILE (276) 3


Nonterminals, with rules where they appear

$accept (22)
    on left: 0
program (23)
    on left: 1, on right: 0
ifthenelse_stmt (24)
    on left: 2, on right: 17
while_stmt (25)
    on left: 3, on right: 18
procs (26)
    on left: 4 5, on right: 1 4
decls (27)
    on left: 6 7, on right: 1 6 8
procdecl (28)
    on left: 8, on right: 4
vars (29)
    on left: 9, on right: 8 10
vars_tail (30)
    on left: 10 11, on right: 9
args (31)
    on left: 12, on right: 13 23
args_tail (32)
    on left: 13 14, on right: 12
stmts (33)
    on left: 15 16, on right: 2 3 8 15
stmt (34)
    on left: 17 18 19 20 21 22, on right: 15
f_call (35)
    on left: 23, on right: 19
decl (36)
    on left: 24, on right: 6
assign (37)
    on left: 25, on right: 20
read (38)
    on left: 26, on right: 21
write (39)
    on left: 27, on right: 22
expr (40)
    on left: 28 29 30, on right: 2 3 12 25 27 33
term (41)
    on left: 31 32 33, on right: 28 29 30
var (42)
    on left: 34, on right: 8 9 23 25 26 32


state 0

    0 $accept: . program $end

    DECLARE  shift, and go to state 1

    $default  reduce using rule 7 (decls)

    program  go to state 2
    decls    go to state 3
    decl     go to state 4


state 1

   24 decl: DECLARE . NAME

    NAME  shift, and go to state 5


state 2

    0 $accept: program . $end

    $end  shift, and go to state 6


state 3

    1 program: decls . procs

    PROC  shift, and go to state 7

    $default  reduce using rule 5 (procs)

    procs     go to state 8
    procdecl  go to state 9


state 4

    6 decls: decl . SEMICOLON decls

    SEMICOLON  shift, and go to state 10


state 5

   24 decl: DECLARE NAME .

    $default  reduce using rule 24 (decl)


state 6

    0 $accept: program $end .

    $default  accept


state 7

    8 procdecl: PROC . var LPAREN vars RPAREN LBRACE decls stmts RBRACE

    NAME  shift, and go to state 11

    var  go to state 12


state 8

    1 program: decls procs .

    $default  reduce using rule 1 (program)


state 9

    4 procs: procdecl . procs

    PROC  shift, and go to state 7

    $default  reduce using rule 5 (procs)

    procs     go to state 13
    procdecl  go to state 9


state 10

    6 decls: decl SEMICOLON . decls

    DECLARE  shift, and go to state 1

    $default  reduce using rule 7 (decls)

    decls  go to state 14
    decl   go to state 4


state 11

   34 var: NAME .

    $default  reduce using rule 34 (var)


state 12

    8 procdecl: PROC var . LPAREN vars RPAREN LBRACE decls stmts RBRACE

    LPAREN  shift, and go to state 15


state 13

    4 procs: procdecl procs .

    $default  reduce using rule 4 (procs)


state 14

    6 decls: decl SEMICOLON decls .

    $default  reduce using rule 6 (decls)


state 15

    8 procdecl: PROC var LPAREN . vars RPAREN LBRACE decls stmts RBRACE

    NAME  shift, and go to state 11

    vars  go to state 16
    var   go to state 17


state 16

    8 procdecl: PROC var LPAREN vars . RPAREN LBRACE decls stmts RBRACE

    RPAREN  shift, and go to state 18


state 17

    9 vars: var . vars_tail

    COMMA  shift, and go to state 19

    $default  reduce using rule 11 (vars_tail)

    vars_tail  go to state 20


state 18

    8 procdecl: PROC var LPAREN vars RPAREN . LBRACE decls stmts RBRACE

    LBRACE  shift, and go to state 21


state 19

   10 vars_tail: COMMA . vars

    NAME  shift, and go to state 11

    vars  go to state 22
    var   go to state 17


state 20

    9 vars: var vars_tail .

    $default  reduce using rule 9 (vars)


state 21

    8 procdecl: PROC var LPAREN vars RPAREN LBRACE . decls stmts RBRACE

    DECLARE  shift, and go to state 1

    $default  reduce using rule 7 (decls)

    decls  go to state 23
    decl   go to state 4


state 22

   10 vars_tail: COMMA vars .

    $default  reduce using rule 10 (vars_tail)


state 23

    8 procdecl: PROC var LPAREN vars RPAREN LBRACE decls . stmts RBRACE

    NAME   shift, and go to state 11
    WRITE  shift, and go to state 24
    READ   shift, and go to state 25
    CALL   shift, and go to state 26
    IF     shift, and go to state 27
    WHILE  shift, and go to state 28

    $default  reduce using rule 16 (stmts)

    ifthenelse_stmt  go to state 29
    while_stmt       go to state 30
    stmts            go to state 31
    stmt             go to state 32
    f_call           go to state 33
    assign           go to state 34
    read             go to state 35
    write            go to state 36
    var              go to state 37


state 24

   27 write: WRITE . expr

    NAME    shift, and go to state 11
    NUMBER  shift, and go to state 38
    LPAREN  shift, and go to state 39

    expr  go to state 40
    term  go to state 41
    var   go to state 42


state 25

   26 read: READ . var

    NAME  shift, and go to state 11

    var  go to state 43


state 26

   23 f_call: CALL . var LPAREN args RPAREN

    NAME  shift, and go to state 11

    var  go to state 44


state 27

    2 ifthenelse_stmt: IF . LPAREN expr RPAREN LBRACE stmts RBRACE ELSE LBRACE stmts RBRACE

    LPAREN  shift, and go to state 45


state 28

    3 while_stmt: WHILE . LPAREN expr RPAREN LBRACE stmts RBRACE

    LPAREN  shift, and go to state 46


state 29

   17 stmt: ifthenelse_stmt .

    $default  reduce using rule 17 (stmt)


state 30

   18 stmt: while_stmt .

    $default  reduce using rule 18 (stmt)


state 31

    8 procdecl: PROC var LPAREN vars RPAREN LBRACE decls stmts . RBRACE

    RBRACE  shift, and go to state 47


state 32

   15 stmts: stmt . SEMICOLON stmts

    SEMICOLON  shift, and go to state 48


state 33

   19 stmt: f_call .

    $default  reduce using rule 19 (stmt)


state 34

   20 stmt: assign .

    $default  reduce using rule 20 (stmt)


state 35

   21 stmt: read .

    $default  reduce using rule 21 (stmt)


state 36

   22 stmt: write .

    $default  reduce using rule 22 (stmt)


state 37

   25 assign: var . ASSIGN expr

    ASSIGN  shift, and go to state 49


state 38

   31 term: NUMBER .

    $default  reduce using rule 31 (term)


state 39

   33 term: LPAREN . expr RPAREN

    NAME    shift, and go to state 11
    NUMBER  shift, and go to state 38
    LPAREN  shift, and go to state 39

    expr  go to state 50
    term  go to state 41
    var   go to state 42


state 40

   27 write: WRITE expr .

    $default  reduce using rule 27 (write)


state 41

   28 expr: term .
   29     | term . PLUS term
   30     | term . MINUS term

    PLUS   shift, and go to state 51
    MINUS  shift, and go to state 52

    $default  reduce using rule 28 (expr)


state 42

   32 term: var .

    $default  reduce using rule 32 (term)


state 43

   26 read: READ var .

    $default  reduce using rule 26 (read)


state 44

   23 f_call: CALL var . LPAREN args RPAREN

    LPAREN  shift, and go to state 53


state 45

    2 ifthenelse_stmt: IF LPAREN . expr RPAREN LBRACE stmts RBRACE ELSE LBRACE stmts RBRACE

    NAME    shift, and go to state 11
    NUMBER  shift, and go to state 38
    LPAREN  shift, and go to state 39

    expr  go to state 54
    term  go to state 41
    var   go to state 42


state 46

    3 while_stmt: WHILE LPAREN . expr RPAREN LBRACE stmts RBRACE

    NAME    shift, and go to state 11
    NUMBER  shift, and go to state 38
    LPAREN  shift, and go to state 39

    expr  go to state 55
    term  go to state 41
    var   go to state 42


state 47

    8 procdecl: PROC var LPAREN vars RPAREN LBRACE decls stmts RBRACE .

    $default  reduce using rule 8 (procdecl)


state 48

   15 stmts: stmt SEMICOLON . stmts

    NAME   shift, and go to state 11
    WRITE  shift, and go to state 24
    READ   shift, and go to state 25
    CALL   shift, and go to state 26
    IF     shift, and go to state 27
    WHILE  shift, and go to state 28

    $default  reduce using rule 16 (stmts)

    ifthenelse_stmt  go to state 29
    while_stmt       go to state 30
    stmts            go to state 56
    stmt             go to state 32
    f_call           go to state 33
    assign           go to state 34
    read             go to state 35

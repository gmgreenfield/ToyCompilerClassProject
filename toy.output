    RPAREN  shift, and go to state 58


state 51

   29 expr: term PLUS . term

    NAME    shift, and go to state 11
    NUMBER  shift, and go to state 38
    LPAREN  shift, and go to state 39

    term  go to state 59
    var   go to state 42


state 52


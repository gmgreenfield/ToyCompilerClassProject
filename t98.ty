declare temp;
declare test;
declare foobar;

proc readand (x, y, z) {
     read x;
     read y;
     write y + z;
}

proc test ( foo, bar, baz ) {
     foo = baz;
     baz = bar;
     bar = foo;
}

proc main ( arg1, arg2 ) {
     call test ( arg1, arg2, arg1 );
     call readandwrite ( temp, test, foobar );
}